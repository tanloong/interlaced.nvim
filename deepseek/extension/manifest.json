{
  "manifest_version": 3,
  "name": "DeepSeek bridge for interlaced.nvim",
  "version": "0.1.0",
  "description": "Feeds text from a local service into the DeepSeek chat page and returns the answer.",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*", "https://*.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
